# --- App ---
APP_ENV=local
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- Database ---
# Local dev database (user requested: db socratic_agent, port 5432, password postgres123)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/socratic_agent

# --- Auth ---
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# --- LLM (Phase 0/3 use the FakeGateway; real providers from Phase 4) ---
LLM_PROVIDER=fake
LLM_MODEL=fake
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- RAG (disabled for MVP, Phase 7 enables it) ---
RAG_ENABLED=false
FAISS_INDEX_DIR=./data/faiss
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MIN_SCORE=0.35
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
MAX_UPLOAD_MB=10

# --- Limits / flags ---
MESSAGES_PER_MINUTE=20
ALLOW_FINAL_REVEAL=false
